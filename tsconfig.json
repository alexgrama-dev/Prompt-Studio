{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "raycast-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.mts",
    "evals/**/*.mts",
    "cli/**/*.mts",
    "mcp/**/*.mts",
    "scripts/**/*.mts"
  ]
}
